# Client (public). Safe to expose to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_FILM_AUTOSTART=true
# Cloudflare Turnstile's own public "always passes" test site key — fine for
# dev/CI (docs.cloudflare.com/turnstile/troubleshooting/testing). Replace
# with the real site key from the owner's Turnstile dashboard before launch.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# The public contact address for T4's "Buy / Enquire" mailto: link. A
# mailto: link is inherently visible in the page regardless, so this is
# meant to be public — distinct from OWNER_EMAIL below, the Edge
# Function's own server-only secret for T5.
VITE_OWNER_EMAIL=

# Local scripts only. Never commit a real value; never expose to the client.
# Put real values in .env.local (git-ignored).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# submit-enquiry (Phase 3 T5) Edge Function secrets — set with:
#   supabase secrets set NAME=value
# RESEND_API_KEY   Resend account API key (needs a verified sending domain).
# RESEND_FROM      Optional; defaults to "ALL LIFE <enquiries@alllifeworks.com>".
# OWNER_EMAIL      Where enquiry notifications are sent (server-only — distinct
#                  from VITE_OWNER_EMAIL above, which is public by necessity).
# TURNSTILE_SECRET Cloudflare Turnstile secret key. For dev/CI, pairs with the
#                  test site key above: 1x0000000000000000000000000000000AA
#                  (Cloudflare's own "always passes" test secret).
# IP_HASH_SALT     Any random string (e.g. `openssl rand -hex 32`); salts the
#                  rate-limit IP hash so raw IPs are never stored.
# ALLOWED_ORIGINS  Comma-separated origins the function accepts requests from,
#                  e.g. https://www.alllifeworks.com,https://alllifeworks.com,*.vercel.app
