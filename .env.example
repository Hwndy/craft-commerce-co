# Client (public). Safe to expose to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_FILM_AUTOSTART=true
VITE_TURNSTILE_SITE_KEY=
# The public contact address for T4's "Buy / Enquire" mailto: link. A
# mailto: link is inherently visible in the page regardless, so this is
# meant to be public — distinct from OWNER_EMAIL below, the Edge
# Function's own server-only secret for T5.
VITE_OWNER_EMAIL=

# Local scripts only. Never commit a real value; never expose to the client.
# Put real values in .env.local (git-ignored).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Edge Function secrets are set with: supabase secrets set NAME=value
# RESEND_API_KEY, OWNER_EMAIL, TURNSTILE_SECRET, IP_HASH_SALT
